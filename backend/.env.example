# JobApplicationTracker Environment Configuration

# Environment
ENVIRONMENT=development

# Database (development = SQLite, production = PostgreSQL)
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL (production - uncomment and fill in):
# DATABASE_URL=postgresql+asyncpg://user:password@your-rds-endpoint:5432/dbname

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here

# S3 Document Storage
S3_BUCKET=jobtracker-documents-245091941294

# Logging
LOG_LEVEL=INFO

# LinkedIn API Credentials
# Get these from: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# GitHub API Token
# Get this from: https://github.com/settings/tokens
GITHUB_ACCESS_TOKEN=github_pat_your_token_here

# Lever ATS API Key (optional)
LEVER_API_KEY=your_lever_key_here

# Greenhouse ATS API Key (optional)
GREENHOUSE_API_KEY=your_greenhouse_key_here

# Job Sync Configuration
JOB_SYNC_INTERVAL_MINUTES=60
ENABLE_JOB_SYNC_ON_STARTUP=true

# API Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider Configuration
# Primary: Bedrock with Claude (NO gate required, use your AWS credentials)
# Fallback: Cerebras API (Llama, requires API key)
AI_PROVIDER=bedrock

# Bedrock Models (Claude via Anthropic — no approval gate needed)
# Two-tier approach for cost optimization:
# FAST models (extraction, scoring, field mapping):  Claude 3 Haiku (fastest, cheapest)
# SMART models (tailoring, cover letters):           Claude 3.5 Sonnet (highest quality)
# Defaults are optimal; override only if needed:
# BEDROCK_FAST_MODEL=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_SMART_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Cerebras AI Fallback (only needed if Bedrock unavailable)
# CEREBRAS_API_KEY=your_key_here
# CEREBRAS_MODEL=llama-3.3-70b

# Keystroke webhook notification (optional)
# Fires an email when an application is auto-submitted. Get the URL with:
#   keystroke triggers url application-submitted
# from the keystroke-agents/ project.
# KEYSTROKE_APPLICATION_WEBHOOK_URL=https://api.keystroke.ai/api/projects/<project-id>/triggers/application-submitted?token=<token>
