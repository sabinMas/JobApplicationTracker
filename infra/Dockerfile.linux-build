# Dockerfile for building Linux-compatible Python package for AWS Lambda Python 3.13
FROM python:3.13-slim

WORKDIR /build

# Install build tools
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/build

# Copy requirements
COPY infra/requirements-lambda.txt .

# Install dependencies into /var/task (Lambda's working directory)
RUN pip install --target /var/task -r requirements-lambda.txt --no-cache-dir

# Copy application code
COPY backend/ /var/task/

# Create a clean deployment package
WORKDIR /var/task
RUN find . -name "__pycache__" -type d -exec rm -rf {} + \
    && find . -name "*.pyc" -delete \
    && rm -rf tests venv .git .github .vscode .pytest_cache

# Create zip file
RUN zip -r /tmp/lambda-deploy-py313-fixed.zip . -x "*.pyc" "*.pyo" "__pycache__/*" ".*"

# Copy zip file to output directory
RUN mkdir -p /tmp/output && cp /tmp/lambda-deploy-py313-fixed.zip /tmp/output/
