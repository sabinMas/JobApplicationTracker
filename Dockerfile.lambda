# AWS Lambda container image for the FastAPI API
# Uses mangum to bridge API Gateway → FastAPI
FROM public.ecr.aws/lambda/python:3.12

# Install system deps needed by some Python packages
RUN dnf install -y libpq-devel && dnf clean all

# Copy requirements and install
COPY backend/requirements.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

# Copy application code
COPY backend/app ${LAMBDA_TASK_ROOT}/app

# Copy the Lambda handler
COPY backend/lambda_handler.py ${LAMBDA_TASK_ROOT}/

# Mangum handler entrypoint
CMD ["lambda_handler.handler"]
